# Daily Affirmations 1.1.0 optional local configuration.
# Keep real keys in private local files, deployment environment variables,
# or Streamlit secrets. Never commit real credentials.

# Optional BYOT online assistant reference values.
# The current app asks for these values in the Streamlit UI at runtime.
AI_API_KEY=
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_MODEL=llama-3.3-70b-versatile

# Optional local Ollama assistant reference values.
# The current app asks for these values in the Streamlit UI at runtime.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional enhanced Hindi/Telugu translation.
# This value is read by the app from the process environment or Streamlit secrets.
SARVAM_API_KEY=
