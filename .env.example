# Optional BYOT online assistant settings.
# The current app asks for these values in the Streamlit UI at runtime.
# Keep real keys in your private local environment only.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Optional local Ollama assistant settings.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
